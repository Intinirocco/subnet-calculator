{
  "name": "subnet-calculator-plugin",
  "version": "0.1.0",
  "description": "Obsidian plugin: calcolatore subnetting nei blocchi ```subnet (VLSM/FLSM, analizzatore, verifica, config Cisco IOS).",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "check": "tsc -noEmit -skipLibCheck",
    "test": "node esbuild.test.mjs && node --test test/"
  },
  "keywords": [
    "obsidian",
    "subnetting",
    "vlsm",
    "flsm",
    "cisco",
    "networking"
  ],
  "author": "Rocco Intini",
  "license": "MIT",
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.11.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.21.5",
    "jsdom": "^24.1.3",
    "obsidian": "^1.5.7",
    "tslib": "^2.6.2",
    "typescript": "^5.4.5"
  }
}
